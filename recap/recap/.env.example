# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- Backend ---
# Tiger Data (TimescaleDB) connection string. Leave empty to use local SQLite.
DATABASE_URL=
# Gemini API key: live word prediction, AI notes, lesson glossary, recap, clinic summary.
# Leave empty and everything falls back to offline methods.
GEMINI_API_KEY=
# Notes / recap / clinic summary (a couple of seconds is fine).
GEMINI_MODEL=gemini-3.5-flash
# Live prediction under captions (must answer in about a second).
GEMINI_LIVE_MODEL=gemini-3.1-flash-lite
# Mic speech-to-text when ELEVENLABS_API_KEY is empty.
GEMINI_STT_MODEL=gemini-3.5-transcribe
# Minimum seconds between live Gemini calls (free-tier quotas are small).
GEMINI_LIVE_MIN_INTERVAL=4
# Predicted words: 1 = on by default (Alex can switch it off on his page).
PREDICT_DEFAULT=1
PREDICT_MIN_CONFIDENCE=0.45
# Seconds a caption must stay unchanged before it counts as a stall.
PREDICT_STALL_SECONDS=1.2
NOTES_EVERY_SECONDS=20
# Lesson material folder (PDF/.txt/.md). Default: ./context
RECAP_CONTEXT_DIR=
# Optional shared secret for write requests (set the same value on every laptop).
RECAP_TOKEN=
# Optional, experimental: anchor consent receipts on Solana devnet (needs the solana CLI).
SOLANA_ANCHOR=0
# Fatigue thresholds
ON_THRESHOLD=55
OFF_THRESHOLD=40
MIN_ON_SECONDS=120
# Comma-separated subject vocabulary for better captions
RECAP_KEYTERMS=mitochondria,photosynthesis,chloroplast,enzyme,osmosis,diffusion,ATP,DNA,RNA,meiosis,mitosis,homeostasis,glycolysis,Krebs cycle,membrane,protein

# --- Clients (audio_client.py, serial_bridge.py, simulator.py) ---
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and adds ~2 s per request.
RECAP_SERVER=http://127.0.0.1:8000
ELEVENLABS_API_KEY=
